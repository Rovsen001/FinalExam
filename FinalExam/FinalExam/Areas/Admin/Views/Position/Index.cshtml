@model List<Position>
<div>
    <h1 class="text-primary">Positions:</h1>
    <a class="btn btn-primary" asp-controller="Position" asp-action="Create">Add Position</a>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Position position in Model)
            {
                <tr>
                    <th scope="row">@position.Id</th>
                    <td>@position.Name</td>
                    <td>
                        @if (!position.IsDeleted)
                        {
                            <p class="text-success">Active</p>
                        }
                        else
                        {
                            <p class="text-danger">Inactive</p>
                        }
                    </td>
                    <td><a asp-controller="Position" asp-action="Update" asp-route-id="@position.Id" class="btn btn-warning">Update</a></td>
                    <td>
                        @if (!position.IsDeleted)
                        {
                            <form asp-controller="Position" asp-action="Delete" asp-route-id="@position.Id" method="post">
                                <button class="btn btn-danger">Delete</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Position" asp-action="Restore" asp-route-id="@position.Id" method="post">
                                <button class="btn btn-success">Restore</button>
                            </form>
                        }
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>